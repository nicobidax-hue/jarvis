# =============================================================================
# .gitignore : fichiers que Git ne doit JAMAIS suivre
# =============================================================================

# --- Secrets et variables d'environnement
.env
.env.*
*.env
!.env.exemple
!.env.example

# --- Réglages personnels Claude Code (propres à cette machine)
.claude/settings.local.json

# --- Clés, certificats et identifiants
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
id_rsa*
id_ed25519*
credentials.json
client_secret*.json
service-account*.json
token.json
secrets/
*.secret

# --- Système
.DS_Store
Thumbs.db
desktop.ini

# --- Dépendances
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# --- Build
dist/
build/
.next/
out/

# --- Éditeurs
.vscode/
.idea/
*.swp
*.swo

# --- Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Fichiers temporaires
tmp/
temp/
*.tmp
*.temp
*.bak
~$*
