# =============================================================================
# .env.exemple : MODÈLE PUBLIC
# =============================================================================
#
# Ce fichier peut être commité. Il liste les variables attendues, SANS valeurs.
# Pour l'utiliser : copier ce fichier en .env, puis remplir les valeurs dans .env.
# Ne jamais mettre de vraie clé ici.
# =============================================================================

# --- Anthropic (Claude) : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- OpenAI : https://platform.openai.com/api-keys
OPENAI_API_KEY=

# --- Notion : https://www.notion.so/my-integrations
NOTION_API_KEY=

# --- YouTube Data API : https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Instagram (Meta Graph API) : https://developers.facebook.com/apps
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# --- TikTok : https://developers.tiktok.com/apps
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Google (Gmail, Agenda, Drive, Sheets) : https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- GitHub : https://github.com/settings/tokens
GITHUB_TOKEN=

# --- Gmail SMTP (envoi des candidatures par /emploi) : https://myaccount.google.com/apppasswords
# Mot de passe d'application (16 caractères), nécessite la validation en deux étapes
GMAIL_ADRESSE=
GMAIL_MOT_DE_PASSE_APPLI=

# --- France Travail, API Offres d'emploi v2 (recherche d'offres pour /emploi) : https://francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Qonto, Business API en SANDBOX (app « automatisation artisans ») : https://developers.qonto.com
# Staging token : en-tête X-Qonto-Staging-Token à ajouter à chaque appel du sandbox (page Overview)
# Client ID et secret : page Authentication
QONTO_SANDBOX_STAGING_TOKEN=
QONTO_SANDBOX_CLIENT_ID=
QONTO_SANDBOX_CLIENT_SECRET=
